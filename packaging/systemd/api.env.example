MQDECK_API_ADDRESS=:8080
MQDECK_INVENTORY_PATH=/etc/mqdeck/inventory.yaml
MQDECK_AGENT_TOKEN=replace-with-a-long-random-secret
MQDECK_DIAGNOSTIC_TIMEOUT=90s
MQDECK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Queue Watch uses one shared sampler per Agent, inventory host, and queue.
MQDECK_QUEUE_WATCH_INTERVAL=5s
MQDECK_QUEUE_WATCH_MAX_DURATION=10m
MQDECK_QUEUE_WATCH_MAX_SAMPLERS=32
MQDECK_QUEUE_WATCH_MAX_PER_AGENT=8
MQDECK_QUEUE_WATCH_MAX_PER_QUEUE_MANAGER=4
MQDECK_QUEUE_WATCH_MAX_CLIENTS=64

# Local on-prem AI (optional). See mqdeck-api/models/README.md
# MQDECK_MODEL_DIR=/opt/mqdeck/api/models
# MQDECK_LLAMA_SERVER_BIN=/opt/mqdeck/llm/llama-server
# MQDECK_LLM_GPU_LAYERS=0
# MQDECK_LLM_BASE_URL=
