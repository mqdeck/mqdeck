[Unit]
Description=MQDeck read-only on-demand worker
Documentation=https://github.com/mqdeck/mqdeck
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mqdeck
Group=mqdeck
ExecStart=/opt/mqdeck/worker/mqdeck-worker
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
