[Unit]
Description=MQDeck web interface
Documentation=https://github.com/mqdeck/mqdeck
Wants=network-online.target
After=network-online.target mqdeck-api.service

[Service]
Type=simple
User=mqdeck
Group=mqdeck
WorkingDirectory=/opt/mqdeck/web
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/node --import /opt/mqdeck/web/load-properties.mjs /opt/mqdeck/web/server.js
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
