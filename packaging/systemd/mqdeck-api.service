[Unit]
Description=MQDeck inventory and Agent control plane
Documentation=https://github.com/mqdeck/mqdeck
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mqdeck
Group=mqdeck
EnvironmentFile=/etc/mqdeck/api.env
ExecStart=/opt/mqdeck/api/mqdeck-api
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
